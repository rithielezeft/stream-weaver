# Copie para .env na Raspberry Pi e preencha os valores reais.
# Banco de dados (obrigatório)
MONGO_URL="mongodb+srv://usuario:senha@seu-cluster.mongodb.net/vela?appName=vela"

# Endereço público do site (usado no retorno do pagamento InfinitePay)
PUBLIC_SITE_URL="https://velatv.zeferius.com"

# Porta em que o site vai rodar na Raspberry (o nginx encaminha para ela)
PORT=8045
HOST=127.0.0.1

# Opcional: segredo do webhook do InfinitePay
# INFINITEPAY_WEBHOOK_SECRET=""
