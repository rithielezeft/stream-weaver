; /etc/systemd/system/velatv.service
; ANTES DE ATIVAR: ajuste User, WorkingDirectory e EnvironmentFile abaixo
; para o usuário e a pasta reais do seu servidor. Exemplo de correção rápida:
;   sudo sed -i 's|^User=.*|User=SEU_USUARIO|; s|^WorkingDirectory=.*|WorkingDirectory=/caminho/da/pasta|; s|^EnvironmentFile=.*|EnvironmentFile=/caminho/da/pasta/.env|' /etc/systemd/system/velatv.service
; Depois:
;   sudo systemctl daemon-reload && sudo systemctl enable --now velatv
[Unit]
Description=Vela.tv (TanStack Start)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/velatv
EnvironmentFile=/home/pi/velatv/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node .output/server/index.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
